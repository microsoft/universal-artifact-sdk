{
  "kind": "operation",
  "name": "study-metadata-extra",
  "description": "`dataset.study.extra` is a spec-defined nested field (SPEC §2.7, resolved §11 Q14), not a binding's unknown-key overflow bucket: it is emitted as a nested `extra:` mapping with its venue-specific values intact, while an unknown sibling key of the same `study` block is round-tripped as a sibling. Both survive write → open → write in both bindings, and the generic extension buckets on neighbouring models (`sample`, `run`, the dataset itself) keep flattening unknown keys into siblings.",
  "operations": [
    {
      "operation": "create_artifact",
      "arguments": {
        "id": "parity-study-extra",
        "title": "Study metadata extra",
        "producer": {
          "name": "parity-harness"
        }
      }
    },
    {
      "operation": "configure_journal",
      "arguments": {
        "actor": "agent:parity",
        "now": [
          "2026-01-01T00:00:00.000Z"
        ]
      }
    },
    {
      "operation": "add_dataset",
      "arguments": {
        "id": "corpus",
        "location": {
          "kind": "in_artifact",
          "path": "data/corpus/"
        },
        "sample": {
          "path": "data/corpus/sample.csv",
          "x_rows": 2
        },
        "study": {
          "ethics_approval": "IRB-2026-0001",
          "consent_basis": "informed, opt-in",
          "extra": {
            "data_use_agreement": "DUA-99",
            "venue": {
              "ethics_track": "PARITY'26",
              "reviewers": 2,
              "waivers": [
                "audio-retention"
              ]
            }
          },
          "x_board": "internal"
        },
        "x_owner": "data-team"
      },
      "context": {
        "rationale": "the interview corpus"
      }
    },
    {
      "operation": "add_experiment",
      "arguments": {
        "slug": "e1",
        "directory": "experiments/e1",
        "run": {
          "command": "python run.py",
          "x_scheduler": "slurm"
        }
      },
      "context": {
        "rationale": "the sweep"
      }
    },
    {
      "operation": "add_result",
      "arguments": {
        "id": "R1",
        "validates": [
          "C1"
        ],
        "evidence": "results/out.csv",
        "kind": "metrics",
        "produced_by": "e1"
      },
      "context": {
        "rationale": "the measurement"
      }
    },
    {
      "operation": "add_claim",
      "arguments": {
        "id": "C1",
        "statement": "Study metadata survives a round trip.",
        "validators": [
          {
            "id": "v1",
            "kind": "attest",
            "checks": "integrity",
            "inputs": [
              "R1"
            ]
          }
        ]
      },
      "context": {
        "rationale": "the headline"
      }
    },
    {
      "operation": "write_submission",
      "arguments": {
        "out": "out",
        "stage_from": "fixtures"
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "out/datasets.yml",
        "select": [
          "datasets",
          0
        ]
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "out/datasets.yml",
        "select": [
          "datasets",
          0,
          "study",
          "extra"
        ]
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "out/manifest.yml",
        "select": [
          "experiments",
          0,
          "run"
        ]
      }
    },
    {
      "operation": "open_submission",
      "arguments": {
        "out": "out",
        "into_session": true
      }
    },
    {
      "operation": "write_submission",
      "arguments": {
        "out": "reopened",
        "stage_from": "fixtures"
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "reopened/datasets.yml",
        "select": [
          "datasets",
          0
        ]
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "reopened/datasets.yml",
        "select": [
          "datasets",
          0,
          "study",
          "extra"
        ]
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "reopened/manifest.yml",
        "select": [
          "experiments",
          0,
          "run"
        ]
      }
    }
  ],
