        "source": "\\absolute\\figure.pdf"
      }
    ],
    "claims": [],
    "assessments": [],
    "paper": {"pdf": "..\\paper.pdf", "source": "paper/", "claims_export": ".sdk/claims.yml", "references_export": "Manifest.yml"},
    "research_agent": {
      "path": "manifest.yml",
      "model": "copilot/gpt-5.5@2026-06-01",
      "grounding_sources": ["claims.yml/context.md", "../outside.md", "   "]
