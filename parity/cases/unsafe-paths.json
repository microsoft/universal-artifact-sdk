    "results": [
      {"id": "R-padded", "validates": [], "evidence": " results/out.csv ", "kind": "metrics"},
      {"id": "R-root", "validates": [], "evidence": ".", "kind": "metrics"}
    ],
    "exhibits": [
      {
        "id": "X",
        "type": "figure",
        "caption": "An exhibit whose rendered and source paths are both unsafe.",
        "validates": [],
