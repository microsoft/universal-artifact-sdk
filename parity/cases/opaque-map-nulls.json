          "accuracy": {
            "column": "acc",
            "row": null
          }
        }
      },
      "context": {
        "rationale": "the measurement"
      }
    },
    {
      "operation": "add_claim",
      "arguments": {
        "id": "C1",
        "statement": "Nulls inside opaque maps survive a round trip.",
        "validators": [
          {
            "id": "v1",
            "kind": "builtin",
            "name": "numeric_close",
            "input": {
              "result": "R1",
              "locator": null
