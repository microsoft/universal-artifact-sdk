{
  "kind": "operation",
  "name": "opaque-map-null-values",
  "description": "A null *value* inside an opaque producer-authored map is data, not an absent optional field: `producer`, `run.env`, a trace's `counters`, a result's `locators` and a builtin validator's `input`/`params` carry their nulls verbatim through write → reopen → write in both bindings. The reviewed null-as-omitted equivalence covers optional *model fields* only (PYTHON_BINDING.md §4.2, §8.4), so `read_document` marks explicit nulls as `<null>` to keep them observable through normalization.",
  "operations": [
    {
      "operation": "create_artifact",
      "arguments": {
        "id": "parity-opaque-nulls",
        "title": "Opaque map nulls",
        "producer": {
          "name": "p",
          "orcid": null,
          "tooling": {
            "linter": null
          }
        }
      }
    },
    {
      "operation": "configure_journal",
      "arguments": {
        "actor": "agent:parity",
        "now": [
          "2026-01-01T00:00:00.000Z"
        ]
      }
    },
    {
      "operation": "add_experiment",
      "arguments": {
        "slug": "e1",
        "directory": "experiments/e1",
        "run": {
          "command": "python run.py",
          "env": {
            "SEED": "1",
            "TOKEN": null
          }
        }
      },
      "context": {
        "rationale": "the sweep"
      }
    },
    {
      "operation": "add_trace",
      "arguments": {
        "id": "T1",
        "kind": "execution_log",
        "path": "traces/run.jsonl",
        "covers": [
          "e1"
        ],
        "counters": {
          "steps": 3,
          "cost_usd": null
        }
      },
      "context": {
        "rationale": "what ran"
      }
    },
    {
      "operation": "add_result",
