            "params": {
              "tolerance": 0.01,
              "unit": null
            }
          }
        ]
      },
      "context": {
        "rationale": "the headline"
      }
    },
    {
      "operation": "write_submission",
      "arguments": {
        "out": "out",
        "stage_from": "fixtures"
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "out/manifest.yml",
        "select": [
          "producer"
        ]
      }
    },
    {
      "operation": "read_document",
      "arguments": {
        "path": "out/manifest.yml",
        "select": [
          "experiments",
          0,
          "run",
          "env"
        ]
      }
