            "checks": "integrity",
            "gated_by": "v_builtin"
          },
          {
            "id": "v_attest_gate",
            "kind": "attest",
            "checks": "ethics"
          },
          {
            "id": "v_attest_gated",
            "kind": "attest",
            "checks": "citations_exist",
            "gated_by": "v_attest_gate"
          }
        ]
      }
    ],
