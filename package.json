{
  "name": "@microsoft/universal-artifact-sdk",
  "version": "0.7.0",
  "description": "Vendor-neutral TypeScript SDK for authoring and serializing evaluable research artifacts that pair a producer's claims with the evidence needed to verify them. See SPEC.md.",
  "keywords": [
    "artifact",
    "evaluable-artifact",
    "research",
    "reproducibility",
    "open-science",
    "json-schema",
    "claims",
    "evidence",
    "sdk"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "homepage": "https://github.com/microsoft/universal-artifact-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/universal-artifact-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/microsoft/universal-artifact-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "SPEC.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
